{
  "name": "oferti7",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "PUT_YOUR_HYPERDRIVE_ID_HERE"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "SITE_URL": "https://oferti7.com",
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
